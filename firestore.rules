rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Un administrador del conjunto: users/{uid}.role == 'admin'
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ¿La cuenta entró con el código del conjunto? Solo un vecino verificado
    // (o la administración) puede reservar, publicar o apartar horas.
    function verificado() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificado == true;
    }
    function delConjunto() { return isAdmin() || verificado(); }

    // El código real vive en config/acceso, que nadie puede leer: las reglas sí.
    // Marcarse 'verificado' exige mandar el código correcto; no hay atajo.
    function codigoOk() {
      return !('verificado' in request.resource.data)
        || request.resource.data.verificado != true
        || request.resource.data.codigoIngresado ==
             get(/databases/$(database)/documents/config/acceso).data.codigo;
    }

    // Terceros solo pueden tocar los agregados de calificación de una estación.
    function onlyRating() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['ratingSum', 'ratingCount']);
    }

    // El campo 'role' no puede aparecer ni cambiar en una auto-edición de perfil.
    function roleUnchanged() {
      return !('role' in request.resource.data)
        || (('role' in resource.data) && request.resource.data.role == resource.data.role);
    }

    // Confirmar el pago y registrar la carga real es potestad del anfitrión,
    // nunca del vecino que reserva.
    // Confirmar el pago y registrar la carga real es potestad del anfitrión,
    // nunca del vecino que reserva. El vecino sí puede dejar constancia de su
    // pago en línea (wompiTxId y compañía): esos datos se verifican después
    // contra Wompi desde la sesión del anfitrión, así que declararlos no basta.
    function pagoUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['pagado', 'pagadoAt', 'pagadoPor', 'pagoMetodo', 'kwhReal', 'totalReal', 'sessionId']);
    }

    // El código del conjunto: ilegible para todos: solo lo consultan estas reglas.
    // Se cambia con `node scripts/backend-setup.js codigo <NUEVO>`.
    match /config/{doc} {
      allow read, write: if false;
    }

    // Perfiles de usuario / residentes
    match /users/{uid} {
      // Cada quien ve su perfil; la administración, el de todos. Nadie más:
      // aquí viven celular, torre, apartamento y el código que escribió.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Al crear, nadie puede autoasignarse un rol ni darse por verificado.
      allow create: if signedIn() && request.auth.uid == uid
        && (!('role' in request.resource.data) || request.resource.data.role == 'guest')
        && codigoOk();

      // Cada quien edita su perfil sin tocar 'role'; el admin puede todo.
      allow update: if (signedIn() && request.auth.uid == uid && roleUnchanged() && codigoOk())
        || isAdmin();
    }

    // Estaciones / puestos de carga: lectura pública, escritura del dueño o admin.
    match /stations/{id} {
      allow read: if true;
      allow create: if delConjunto() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (signedIn() && (resource.data.ownerUid == request.auth.uid || onlyRating()))
        || isAdmin();
      allow delete: if (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();

      // Llaves de la pasarela de pago (Wompi) del anfitrión.
      // Fuera del documento del puesto, que es de lectura pública: aquí solo
      // entra quien tiene sesión, porque su celular necesita firmar el cobro.
      match /pay/{doc} {
        allow read: if signedIn();
        allow write: if isAdmin()
          || (signedIn() && get(/databases/$(database)/documents/stations/$(id)).data.ownerUid == request.auth.uid);
      }
    }

    // Franjas horarias apartadas. El id es fijo (puesto__fecha__hora), así que
    // crear una que ya existe falla: ahí está el bloqueo contra reservas dobles.
    // No se permite 'update': una hora se libera borrándola, no pisándola.
    match /slots/{slotId} {
      allow read: if signedIn();
      allow create: if delConjunto() && request.resource.data.driverUid == request.auth.uid;
      allow delete: if isAdmin()
        || (signedIn() && (resource.data.driverUid == request.auth.uid
                        || resource.data.ownerUid == request.auth.uid));
    }

    // Reservas: conductor y anfitrión involucrados, y el admin del conjunto.
    match /bookings/{id} {
      allow create: if delConjunto() && request.resource.data.driverUid == request.auth.uid;
      allow read: if (signedIn() &&
          (resource.data.driverUid == request.auth.uid ||
           resource.data.ownerUid == request.auth.uid))
        || isAdmin();
      // El anfitrión (y el admin) pueden todo; el vecino, todo menos el pago.
      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && resource.data.driverUid == request.auth.uid && pagoUnchanged());
    }

    // Cargas medidas con la calculadora del anfitrión (historial real del conjunto).
    // Solo las ve quien las registró y la administración.
    match /sessions/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Chats: solo participantes
    match /chats/{chatId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantes;
      allow read, update: if signedIn() && request.auth.uid in resource.data.participantes;

      match /messages/{mid} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
        allow create: if signedIn() &&
          request.resource.data.from == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
      }
    }

    // Calificaciones: lectura pública, crea solo el autor (1-5 estrellas)
    match /ratings/{id} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.stars is number &&
        request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
    }
  }
}
